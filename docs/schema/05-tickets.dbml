// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Table tickets {
  id uuid [primary key, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  customer_id uuid [not null]
  page_id uuid [not null]
  sla_id uuid
  channel varchar(50) [not null]
  source_type varchar(50) [not null, default: 'direct_message']
  external_thread_id varchar(255)
  ticket_number varchar(50) [not null, unique]
  status varchar(20) [not null, default: 'new']
  priority varchar(20) [not null, default: 'normal']
  assigned_to uuid
  linked_order_id varchar(255)
  linked_order_data jsonb
  about text
  reason_id uuid
  is_helpful boolean
  csat_rating smallint
  csat_rated_at timestamp
  auto_resolved boolean [not null, default: false]
  resolved_at timestamp
  resolved_by uuid
  first_message_at timestamp
  last_message_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Ref tickets_to_tenants: tickets.tenant_id > tenants.id // many-to-one
Ref tickets_to_customers: tickets.customer_id > customers.id // many-to-one
Ref tickets_to_pages: tickets.page_id > pages.id // many-to-one
Ref tickets_to_slas: tickets.sla_id > slas.id // many-to-one
Ref tickets_assigned_to_agents: tickets.assigned_to > agents.id // many-to-one
Ref tickets_resolved_by_agents: tickets.resolved_by > agents.id // many-to-one
Ref tickets_to_reasons: tickets.reason_id > reasons.id // many-to-one
