// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Table labels {
  id         uuid         [primary key, default: `gen_random_uuid()`]
  tenant_id  uuid         [not null]
  name       varchar(100) [not null, note: 'Label name — unique per tenant e.g. Order Tracking, Refund Related']
  color      varchar(20)  [null, note: 'Hex color code e.g. #4CAF50']
  is_active  boolean      [not null, default: true, note: 'Soft delete — inactive labels not shown in dropdowns']
  created_by uuid         [not null, note: 'FK → agents. Agent who created this label']
  created_at timestamp    [not null, default: `now()`]
  updated_by uuid         [null, note: 'FK → agents. Last agent who edited']
  updated_at timestamp    [not null, default: `now()`]
}

Ref labels_to_tenants: labels.tenant_id > tenants.id        // many-to-one
Ref labels_created_by: labels.created_by > agents.id        // many-to-one
Ref labels_updated_by: labels.updated_by > agents.id        // many-to-one
